{
  "name": "@dedsec/ui",
  "version": "0.1.0",
  "description": "Shared DedSec user interface package by Mauricio Vuljevas for reusable design tokens, components, accessibility patterns, and product interaction systems across the website and desktop app.",
  "author": {
    "name": "Mauricio Vuljevas",
    "url": "https://www.mvuljevas.com"
  },
  "license": "MIT",
  "homepage": "https://www.mvuljevas.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/mvuljevas/DedSec.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/mvuljevas/DedSec/issues"
  },
  "keywords": [
    "dedsec",
    "mauricio-vuljevas",
    "ui",
    "design-system",
    "components",
    "accessibility",
    "desktop-app",
    "website",
    "typescript"
  ],
  "dedsec": {
    "surface": "shared-ui",
    "authorUri": "https://www.mvuljevas.com",
    "repositoryUri": "https://github.com/mvuljevas/DedSec",
